# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to git — it holds your secrets.

# ---- MongoDB connection ----
# Local MongoDB (if you installed MongoDB Community Server yourself):
MONGODB_URI=mongodb://127.0.0.1:27017/coconuts

# OR MongoDB Atlas (cloud, free tier) — get this from Atlas > Connect > Drivers.
# It looks like: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/coconuts
# MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/coconuts

# ---- Server ----
PORT=3000
SESSION_SECRET=change-this-to-a-random-long-string

# ---- Optional: payment gateway API keys ----
# Only needed if/when you wire up real payments at checkout instead of the
# demo order flow. Leave blank until you're ready for that.
# Razorpay (India):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stripe (international):
STRIPE_SECRET_KEY=
